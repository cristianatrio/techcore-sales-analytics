table Vendedores
	lineageTag: bf89dc44-3c57-4a9b-ab60-a8998ea64b47

	column VendedorID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ec317282-8289-4124-8e8e-d94ec4a6dbba
		summarizeBy: none
		sourceColumn: VendedorID

	column NombreVendedor
		dataType: string
		lineageTag: ecff9ade-7b42-470a-9c5d-d417114586d5
		summarizeBy: none
		sourceColumn: NombreVendedor

	partition Vendedores = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents(RutaDatos & "modeloVentas.xlsx"), null, true),
				    Hoja = Origen{[Item="Vendedores",Kind="Sheet"]}[Data],
				    Encabezados = Table.PromoteHeaders(Hoja, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"VendedorID", Int64.Type}, {"NombreVendedor", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table
