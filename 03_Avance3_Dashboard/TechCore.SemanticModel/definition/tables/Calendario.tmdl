table Calendario
	lineageTag: 730921bd-5e52-47cc-9ae9-b71dc830fdd0
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: ba421908-50fd-47f3-965c-90fc5116c072
		summarizeBy: none
		sourceColumn: [Date]

	column Año
		dataType: int64
		formatString: 0
		lineageTag: 64414f52-9f5b-4b81-917a-38156348eb45
		summarizeBy: none
		sourceColumn: [Año]

	column NroMes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7735ba98-5561-48ce-b579-45a18569cbd1
		summarizeBy: none
		sourceColumn: [NroMes]

	column Mes
		dataType: string
		lineageTag: f7cb419a-faf2-4d31-9258-b333bf840b31
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: NroMes

	column Trimestre
		dataType: string
		lineageTag: c0c8a4ca-1d23-454b-ae55-7a16415e564b
		summarizeBy: none
		sourceColumn: [Trimestre]

	column AñoMes
		dataType: string
		lineageTag: e7af3ae5-cc90-4dea-b8e0-b6f78d7a462c
		summarizeBy: none
		sourceColumn: [AñoMes]

	column NroDiaSemana
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: db8b71bf-28c4-4781-8d3f-a84c41867a1c
		summarizeBy: none
		sourceColumn: [NroDiaSemana]

	column DiaSemana
		dataType: string
		lineageTag: ae7a24c7-af81-47b7-8958-c2c298ccc2a5
		summarizeBy: none
		sourceColumn: [DiaSemana]
		sortByColumn: NroDiaSemana

	column Cobertura
		dataType: string
		lineageTag: a7017f1e-1003-4cfb-af55-d77f6e014af3
		summarizeBy: none
		sourceColumn: [Cobertura]

	partition Calendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(YEAR(MIN(Facturas[Fecha])),1,1), DATE(YEAR(MAX(Facturas[Fecha])),12,31)),
				    "Año", YEAR([Date]),
				    "NroMes", MONTH([Date]),
				    "Mes", SWITCH(MONTH([Date]),1,"Ene",2,"Feb",3,"Mar",4,"Abr",5,"May",6,"Jun",7,"Jul",8,"Ago",9,"Sep",10,"Oct",11,"Nov",12,"Dic"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "AñoMes", FORMAT([Date], "yyyy-MM"),
				    "NroDiaSemana", WEEKDAY([Date], 2),
				    "DiaSemana", SWITCH(WEEKDAY([Date], 2),1,"Lun",2,"Mar",3,"Mié",4,"Jue",5,"Vie",6,"Sáb",7,"Dom"),
				    "Cobertura", IF(YEAR([Date]) IN {2014, 2025}, "Año parcial", "Año completo")
				)

