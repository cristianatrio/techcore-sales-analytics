table Calendario
	dataCategory: Time
	lineageTag: a9f751ab-dd5e-49b7-88cf-36aa8d092707

	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 4ab70fa2-0aa1-4af4-bfd2-678da3c27e3d
		summarizeBy: none
		sourceColumn: [Date]

	column Año
		dataType: int64
		formatString: 0
		lineageTag: 79ab6c0d-0955-45fc-b920-784ba5b1cc8b
		summarizeBy: none
		sourceColumn: [Año]

	column NroMes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2cda1d65-3775-4d2a-bcbe-fd11b6de61cf
		summarizeBy: none
		sourceColumn: [NroMes]

	column Mes
		dataType: string
		lineageTag: c4143f76-df14-41a4-933e-b3d13fcd0547
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: NroMes

	column Trimestre
		dataType: string
		lineageTag: 5ed4e38b-0df7-4d2e-bafc-16b8839e4ff7
		summarizeBy: none
		sourceColumn: [Trimestre]

	column AñoMes
		dataType: string
		lineageTag: 58993056-69b6-42aa-9539-9ea796c72ed6
		summarizeBy: none
		sourceColumn: [AñoMes]

	column NroDiaSemana
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7a51e5ed-8595-4448-87f5-1c17ff2cb649
		summarizeBy: none
		sourceColumn: [NroDiaSemana]

	column DiaSemana
		dataType: string
		lineageTag: 2c1364fc-ad1f-42b1-9092-e1a0960e38d8
		summarizeBy: none
		sourceColumn: [DiaSemana]
		sortByColumn: NroDiaSemana

	column Cobertura
		dataType: string
		lineageTag: 738df85e-949d-4879-9cc1-fbf24b131ae3
		summarizeBy: none
		sourceColumn: [Cobertura]

	partition Calendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(YEAR(MIN(Facturas[Fecha])),1,1), DATE(YEAR(MAX(Facturas[Fecha])),12,31)),
				    "Año", YEAR([Date]),
				    "NroMes", MONTH([Date]),
				    "Mes", SWITCH(MONTH([Date]),1,"Ene",2,"Feb",3,"Mar",4,"Abr",5,"May",6,"Jun",7,"Jul",8,"Ago",9,"Sep",10,"Oct",11,"Nov",12,"Dic"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "AñoMes", FORMAT([Date], "yyyy-MM"),
				    "NroDiaSemana", WEEKDAY([Date], 2),
				    "DiaSemana", SWITCH(WEEKDAY([Date], 2),1,"Lun",2,"Mar",3,"Mié",4,"Jue",5,"Vie",6,"Sáb",7,"Dom"),
				    "Cobertura", IF(YEAR([Date]) IN {2014, 2025}, "Año parcial", "Año completo")
				)
