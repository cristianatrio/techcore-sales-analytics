	partition Facturas = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents(RutaDatos & "modeloVentas.xlsx"), null, true),
				    Hoja = Origen{[Item="Facturas",Kind="Sheet"]}[Data],
				    Encabezados = Table.PromoteHeaders(Hoja, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"FacturaID", Int64.Type}, {"Fecha", type date}, {"Hora", type time}, {"SucursalID", Int64.Type}, {"VendedorID", Int64.Type}, {"ClienteID", Int64.Type}, {"MetodoPago", type text}, {"Subtotal", Int64.Type}, {"DescuentoPct", Percentage.Type}, {"Total", Int64.Type}, {"MontoDescuento", Int64.Type}})
				in
				    Tipos

	annotation PBI_ResultType = Table
