/// Medidas DAX del modelo TechCore
table _Medidas
	lineageTag: f6ff6c49-7ede-4b5c-a653-d16ee99033dc

	/// Ventas netas (después de descuentos). Cuadra con Facturas[Total].
	measure VentasTotales = SUM(DetalleFacturas[SubtotalNeto])
		formatString: \$#,0
		displayFolder: 1. Ventas
		lineageTag: db2b7b8e-9eb7-461a-82ce-ff5bd477f0fc

	measure VentasBrutas = SUM(DetalleFacturas[Subtotal])
		formatString: \$#,0
		displayFolder: 1. Ventas
		lineageTag: 4bc13b20-6d86-4075-8dd1-4a9ee416004b

	measure Descuentos = SUM(Facturas[MontoDescuento])
		formatString: \$#,0
		displayFolder: 1. Ventas
		lineageTag: 86ccd130-6f32-4f05-b545-5bb213a4c289

	measure '%Descuento' = DIVIDE([Descuentos], [VentasBrutas])
		formatString: 0.0%
		displayFolder: 1. Ventas
		lineageTag: f35a8f17-8e52-4729-a11c-2a2aff76eeb6

	measure TicketPromedio = DIVIDE([VentasTotales], [NroFacturas])
		formatString: \$#,0
		displayFolder: 1. Ventas
		lineageTag: bd3bfc81-4a8f-4ffd-bd8e-fdfe5d5a9d1b

	measure NroFacturas = DISTINCTCOUNT(Facturas[FacturaID])
		formatString: #,0
		displayFolder: 2. Volumen
		lineageTag: e2942d96-07bf-4c0e-8d86-3a6f63ec4963

	measure ProductosVendidos = SUM(DetalleFacturas[Cantidad])
		formatString: #,0
		displayFolder: 2. Volumen
		lineageTag: 268f8ce7-e40f-4ebd-b7a9-13019551a1fc

	measure Clientes = DISTINCTCOUNT(Facturas[ClienteID])
		formatString: #,0
		displayFolder: 2. Volumen
		lineageTag: 535b343e-8227-4768-bbd8-a43f3babf219

	measure UnidadesPorFactura = DIVIDE([ProductosVendidos], [NroFacturas])
		formatString: 0.00
		displayFolder: 2. Volumen
		lineageTag: 723f98fb-93d2-4b3e-acbc-ed261cee27ce

	measure '%ParticipacionCiudad' = DIVIDE([VentasTotales], CALCULATE([VentasTotales], ALL(Ciudades)))
		formatString: 0.0%
		displayFolder: 3. Participación
		lineageTag: 9de15d6f-9dab-4a51-971e-7a89875feeb1

	measure '%ParticipacionProducto' = DIVIDE([VentasTotales], CALCULATE([VentasTotales], ALL(Productos)))
		formatString: 0.0%
		displayFolder: 3. Participación
		lineageTag: 9e0dde38-e32e-4170-9429-1d5358da3739

	measure '%ParticipacionMarca' = DIVIDE([VentasTotales], CALCULATE([VentasTotales], ALL(Productos[Marca])))
		formatString: 0.0%
		displayFolder: 3. Participación
		lineageTag: d41c96c9-c279-4c82-b354-90a98186494e

	/// Mismo período del año anterior, recortado a la última fecha con ventas (comparación justa en 2025 YTD).
	measure VentasAnioAnterior =
				VAR _hasta = MAX(Facturas[Fecha])
				RETURN
				    CALCULATE(
				        [VentasTotales],
				        SAMEPERIODLASTYEAR(Calendario[Fecha]),
				        Calendario[Fecha] <= EDATE(_hasta, -12)
				    )
		formatString: \$#,0
		displayFolder: 4. Inteligencia de tiempo
		lineageTag: 57fd0d91-bf68-407e-bec2-c9f4a5fc47dd

	/// Crecimiento del último año seleccionado frente al mismo período del año anterior (año parcial comparado de forma justa).
	measure CrecimientoYoY =
				VAR _anio = MAX(Calendario[Año])
				VAR _hasta = CALCULATE(MAX(Facturas[Fecha]), REMOVEFILTERS(Calendario), Calendario[Año] = _anio)
				VAR _actual = CALCULATE([VentasTotales], REMOVEFILTERS(Calendario), Calendario[Año] = _anio)
				VAR _previo = CALCULATE([VentasTotales], REMOVEFILTERS(Calendario), Calendario[Año] = _anio - 1, Calendario[Fecha] <= EDATE(_hasta, -12))
				RETURN IF(NOT ISBLANK(_previo), DIVIDE(_actual - _previo, _previo))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4. Inteligencia de tiempo
		lineageTag: a154f635-eabc-4720-8987-37c6393a6156

	measure VentasYTD = TOTALYTD([VentasTotales], Calendario[Fecha])
		formatString: \$#,0
		displayFolder: 4. Inteligencia de tiempo
		lineageTag: f94abd11-9246-4d45-b409-08644614842b

	/// Suma móvil de 12 meses: evita el sesgo de años parciales (2014 y 2025).
	measure VentasMovil12M = CALCULATE([VentasTotales], DATESINPERIOD(Calendario[Fecha], MAX(Calendario[Fecha]), -12, MONTH))
		formatString: \$#,0
		displayFolder: 4. Inteligencia de tiempo
		lineageTag: 3ba4c7e3-42f7-4df2-8335-da47409113cb

	measure VentasMillones = DIVIDE([VentasTotales], 1000000)
		formatString: \$#,0.0," M"
		displayFolder: 5. Formato
		lineageTag: f1e38c02-21d9-4703-b595-5c376a77799a

	measure TituloPeriodo =
				VAR _min = MIN(Calendario[Fecha])
				VAR _max = MAX(Calendario[Fecha])
				RETURN FORMAT(_min, "dd/mm/yyyy") & "  →  " & FORMAT(MIN(_max, MAX(Facturas[Fecha])), "dd/mm/yyyy")
		displayFolder: 5. Formato
		lineageTag: 948d71a0-02d1-4df2-bb4e-3cb8f8b838d3

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = #table(type table [Columna1 = text], {})
				in
				    Origen

	annotation PBI_ResultType = Table
