	partition Productos = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents(RutaDatos & "modeloVentas.xlsx"), null, true),
				    Hoja = Origen{[Item="Productos",Kind="Sheet"]}[Data],
				    Encabezados = Table.PromoteHeaders(Hoja, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"ProductoID", Int64.Type}, {"Nombre", type text}, {"Marca", type text}, {"Precio", Int64.Type}})
				in
				    Tipos

	annotation PBI_ResultType = Table
