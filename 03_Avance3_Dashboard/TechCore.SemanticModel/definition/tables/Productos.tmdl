table Productos
	lineageTag: 255a7ecb-eb1e-495b-9881-dc9153a4c6cb

	column ProductoID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a2986a39-b5ec-412c-a521-66d907673e69
		summarizeBy: none
