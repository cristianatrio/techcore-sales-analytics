	partition Clientes = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents(RutaDatos & "modeloVentas.xlsx"), null, true),
				    Hoja = Origen{[Item="Clientes",Kind="Sheet"]}[Data],
				    Encabezados = Table.PromoteHeaders(Hoja, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"ClienteID", Int64.Type}, {"Nombre", type text}, {"Genero", type text}, {"Edad", Int64.Type}, {"Email", type text}, {"Telefono", type text}, {"Direccion", type text}})
				in
