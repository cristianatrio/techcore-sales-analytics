model Model
	culture: es-AR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Ciudades","Sucursales","Vendedores","Clientes","Productos","Facturas","DetalleFacturas","_Medidas","UsuariosSeguridad","RutaDatos"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Ciudades
ref table Sucursales
ref table Vendedores
ref table Clientes
ref table Productos
ref table Facturas
ref table DetalleFacturas
ref table Calendario
ref table _Medidas
ref table UsuariosSeguridad

ref role 'Gerente Nacional'
ref role 'Gerente Regional'
ref role 'Gerente Sucursal'

ref cultureInfo es-AR

